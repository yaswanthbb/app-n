PUBLISH_TOKEN=replace-with-a-long-random-private-token
DATABASE_URL=sqlite:///./newsapp.db
# Render sets DATABASE_URL to Postgres through render.yaml.
# Paste the complete Firebase service-account JSON as one env value on Render.
# Leave unset locally to queue pushes until Firebase is configured.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to JSON: base64-encoded service-account JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64=
